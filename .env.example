# =============================================================================
# WAF Management Platform — Environment Variables
# Copy this file to .env and fill in all CHANGE_ME values before first run.
# Never commit .env to source control.
# =============================================================================

# --- Image version -------------------------------------------------------
# Pin a version for reproducible deploys: the release number without the "v"
# (e.g. 1.0.42 for release v1.0.42). "latest" tracks the newest published image.
WAF_IMAGE_TAG=1.0.42

# Pin production Caddy and its validator to the SAME release digest. Update this
# together with WAF_IMAGE_TAG; see docs/releases/v1.0.42.md. Leaving it blank
# disables managed CRS activation but does not disable existing WAF traffic.
CRS_CADDY_DIGEST=sha256:5c63210e65ae83c6c940f74f1438bc64481003ea0de1c4d9196e539d7c9a9b85

# Recovery procedure only: true starts production Caddy admin-only.
CONFIG_RECOVERY_ONLY=false

# --- GeoIP (MaxMind GeoLite2) --------------------------------------------
# Host path to your own GeoLite2-City.mmdb. MaxMind licensing prevents us
# from bundling it. See the README "GeoIP setup" section to obtain one free.
GEOIP_DB_PATH=./GeoLite2-City.mmdb

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_DB=wafdb
POSTGRES_USER=wafuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- API Security --------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_at_least_32_random_characters

# Comma-separated list of allowed CORS origins (no wildcard).
# For the default local deploy, use the UI's HTTPS URL:
ALLOWED_ORIGINS=https://localhost:8443

# TOTP encryption key — generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_with_command_above

# --- Caddy Admin API (container-internal) --------------------------------
CADDY_ADMIN_URL=http://caddy-waf:2019

# --- SMTP (for alert notifications) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Release update check ------------------------------------------------
# The admin API asks GitHub (api.github.com) for the newest public release, at
# most once every 6 hours, and the admin UI tells admins when a newer version
# is available. Set to false on hosts without internet access.
UPDATE_CHECK_ENABLED=true

# --- Bootstrap superadmin (seeded on first run only) ---------------------
# Change the password immediately after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
